<Window x:Class="Alpha.Branding.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Alpha Premier Realty | Branding Studio" Width="1100" Height="760" Background="{StaticResource Charcoal}" Foreground="White">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Image Source="Assets/logo.png" Height="72" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="PROPERTY BRANDING STUDIO" Foreground="{StaticResource Gold}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Prepare listing photography for Alpha Premier Realty" Margin="0,4,0,20" Foreground="#C8C8C8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Select photos" Click="SelectPhotos_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Padding="18,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Filename prefix" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="6" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <TextBlock Text="Example: " VerticalAlignment="Center" Margin="18,0,4,0" Foreground="#999"/>
                <TextBlock Text="{Binding PatternPreview}" VerticalAlignment="Center" Foreground="{StaticResource Gold}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                <Button Content="Apply branding" Click="Apply_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Padding="18,8" Margin="0,0,10,0"/>
                <Button Content="Export ZIP" Click="Export_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Padding="18,8"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Width="240" Height="16" Margin="20,4,10,0"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="250" Margin="0,0,14,14" Padding="10" Background="#303236">
                            <StackPanel>
                                <Image Source="{Binding Preview}" Height="190" Stretch="Uniform"/>
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Gold}" Margin="0,8,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Preview" Click="Preview_Click" IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}" Padding="10,4" Margin="0,0,8,0"/>
                                    <Button Content="Save" Click="Save_Click" IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}" Padding="10,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
