<Window x:Class="Alpha.Branding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier | Property Branding Studio"
        Icon="Assets/logo_phoenix.png"
        Width="1220" Height="840"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Control Card -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BRANDING HEADER (Matches alphapremiergroup.com header) -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Phoenix Emblem -->
                <Image Grid.Column="0"
                       Source="Assets/logo_phoenix.png"
                       Height="48"
                       Width="48"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Header Title & Company Slogan -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ALPHA PREMIER"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" | REALTY"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <Border Background="{StaticResource GoldSubtle}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="GROUP OF COMPANIES"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Official Property Listing Watermarking &amp; Studio Suite"
                               Foreground="{StaticResource Gold}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Actions & Selection Status in Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CHECK FOR UPDATES"
                            AutomationProperties.AutomationId="CheckForUpdatesButton"
                            ToolTip="Check GitHub Releases for new updates"
                            Click="CheckForUpdates_Click"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,12,0"/>

                    <Border Background="{StaticResource SurfaceElevated}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="16,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectionSummary}"
                                       AutomationProperties.AutomationId="SelectionSummaryTextBlock"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTROL & ACTION WORKSPACE CARD -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,18"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- File Selection & Prefix Input -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="SELECT MEDIA"
                                AutomationProperties.AutomationId="SelectPhotosButton"
                                ToolTip="Select property photography and video clips to brand (Ctrl+O)"
                                Click="SelectPhotos_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,18,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FILENAME PREFIX"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="PrefixTextBox"
                                         ToolTip="Custom filename prefix for output assets. Special characters are automatically sanitized."
                                         Width="180"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                <Border Background="{StaticResource GoldSubtle}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Preview: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding PatternPreview}"
                                                   AutomationProperties.AutomationId="PatternPreviewTextBlock"
                                                   Foreground="{StaticResource GoldLight}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Branding Template Selector & Aspect Ratio Indicator -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="BRANDING TEMPLATE"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource GoldSubtle}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveTemplateAspectRatio}"
                                           AutomationProperties.AutomationId="ActiveTemplateAspectRatioTextBlock"
                                           Foreground="{StaticResource GoldLight}"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                      SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="TemplateComboBox"
                                      ToolTip="Select branding template overlay. Templates maintain strict aspect ratios to prevent distortion."
                                      Width="180"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="{StaticResource GoldSubtle}"
                                                    BorderBrush="{StaticResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="OFFICIAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldLight}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="+ IMPORT"
                                    AutomationProperties.AutomationId="ImportTemplateButton"
                                    ToolTip="Import and save a new branding template image to the system"
                                    Click="ImportTemplate_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="6,0,0,0"/>
                            <Button Content="DELETE"
                                    AutomationProperties.AutomationId="DeleteTemplateButton"
                                    ToolTip="Delete selected custom template"
                                    Click="DeleteTemplate_Click"
                                    IsEnabled="{Binding CanDeleteActiveTemplate}"
                                    Visibility="{Binding CanDeleteActiveTemplate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons & Pre-apply Session Indicator -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <!-- Session notice / Unsaved edits warning indicator -->
                        <Border x:Name="SessionNoticeBorder"
                                AutomationProperties.AutomationId="SessionStatusIndicatorBorder"
                                Visibility="{Binding HasApplyHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource GoldSubtle}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasApplyWarning}" Value="True">
                                             <Setter Property="Background" Value="#2D1A10"/>
                                             <Setter Property="BorderBrush" Value="#E07A2B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Gold}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasApplyWarning}" Value="True">
                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="ApplyStatusHintTextBlock"
                                           Text="{Binding ApplyStatusHint}"
                                           AutomationProperties.AutomationId="ApplyStatusHintTextBlock"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasApplyWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="APPLY BRANDING"
                                    AutomationProperties.AutomationId="ApplyBrandingButton"
                                    ToolTip="Process and watermark selected property photos and videos (Ctrl+B / F5)"
                                    Click="Apply_Click"
                                    IsEnabled="{Binding CanApply}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,12,0"/>

                            <Button x:Name="ExportDropdownButton"
                                    AutomationProperties.AutomationId="ExportZipButton"
                                    ToolTip="Export branded photos and videos as ZIP archive or individual files (Ctrl+E / Ctrl+Shift+E)"
                                    Click="ExportDropdown_Click"
                                    IsEnabled="{Binding CanExport}"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="EXPORT" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="8,1,0,0"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ExportContextMenu"
                                                 AutomationProperties.AutomationId="ExportContextMenu">
                                        <MenuItem x:Name="ExportZipMenuItem"
                                                  AutomationProperties.AutomationId="ExportZipMenuItem"
                                                  Header="Export as ZIP Archive (.zip)"
                                                  InputGestureText="Ctrl+E"
                                                  ToolTip="Package all branded assets into a single ZIP archive"
                                                  Click="ExportZip_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ExportIndividualMenuItem"
                                                  AutomationProperties.AutomationId="ExportIndividualMenuItem"
                                                  Header="Export as Individual Files..."
                                                  InputGestureText="Ctrl+Shift+E"
                                                  ToolTip="Save all branded photos and videos directly to a selected folder"
                                                  Click="ExportIndividual_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Divider & Progress / Status Row -->
                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,16,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="STATUS: " Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Status}"
                                   AutomationProperties.AutomationId="StatusTextBlock"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="12"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <ProgressBar Grid.Column="1"
                                 AutomationProperties.AutomationId="ProgressBar"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Height="8"
                                 VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MAIN GALLERY / RESULTS AREA -->
        <Grid Grid.Row="2">
            <!-- Empty State Display -->
            <Border Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="EmptyStateBorder"
                    AllowDrop="True"
                    CornerRadius="12"
                    Padding="40">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceDark}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="Background" Value="#251E14"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C5A059" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                    <Image Source="Assets/logo_phoenix.png"
                           Height="100"
                           Width="100"
                           Margin="0,0,0,22"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.85"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Drag-Over Visual Callout Badge: Appears when videos or photos are dragged over the box -->
                    <Border AutomationProperties.AutomationId="DragDropReactionBadge"
                            Visibility="{Binding IsDragOver, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#382C17"
                            BorderBrush="{StaticResource GoldLight}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="20,10"
                            Margin="0,0,0,18"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Fill="{StaticResource GoldLight}" Stretch="Uniform" Margin="0,0,10,0"
                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                            <TextBlock Text="DROP VIDEOS &amp; PHOTOS HERE TO IMPORT"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Alpha Premier Property Branding"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,0,0,26">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Import property photography and walkthrough video clips to apply official Alpha Premier Realty watermarks and generate publication-ready high-resolution assets."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                        <Setter Property="Text" Value="Release mouse button to import property videos and photography into your branding session."/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="SELECT MEDIA TO BEGIN"
                            AutomationProperties.AutomationId="EmptyStateSelectButton"
                            ToolTip="Choose photos and videos from your computer to start (Ctrl+O)"
                            Click="SelectPhotos_Click"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Padding="28,12"/>
                </StackPanel>
            </Border>

            <!-- Staged / Selected Photos & Videos Gallery Display -->
            <Grid Visibility="{Binding HasSelectedPhotos, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Staged Section Header & Quick Action -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceDark}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SELECTED MEDIA (" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedFiles.Count}" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text=") — Ready to process. Click 'APPLY BRANDING' to watermark." Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Layout Mode Options -->
                            <Button Content="COMBINE IMAGES"
                                    AutomationProperties.AutomationId="CombineImagesButton"
                                    ToolTip="Automatically combine portrait photos into pairs (6:5 layout)"
                                    Click="CombineImages_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="0,0,6,0"/>

                            <Button Content="KEEP SEPARATE"
                                    AutomationProperties.AutomationId="SeparateImagesButton"
                                    ToolTip="Keep every photo as an individual separate branded image"
                                    Click="SeparateImages_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="0,0,6,0"/>

                            <Button Content="RESET ALL CROPS"
                                    AutomationProperties.AutomationId="ResetAllStagedCropsButton"
                                    ToolTip="Reset crop adjustments for all staged photos"
                                    Click="ResetAllStagedCrops_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="0,0,12,0"/>

                            <Button Content="ADD MORE"
                                    AutomationProperties.AutomationId="AddMorePhotosButton"
                                    ToolTip="Select additional photos or videos to add to this session"
                                    Click="AddMorePhotos_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="APPLY BRANDING"
                                    AutomationProperties.AutomationId="StagedApplyButton"
                                    ToolTip="Process and watermark selected property photos and videos (Ctrl+B / F5)"
                                    Click="Apply_Click"
                                    IsEnabled="{Binding CanApply}"
                                    Style="{StaticResource SmallGoldButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Staged Media Grid -->
                <ScrollViewer Grid.Row="1"
                              AutomationProperties.AutomationId="SelectedPhotosScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedPhotos}"
                                  AutomationProperties.AutomationId="SelectedPhotosItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="270"
                                        Margin="0,0,16,16"
                                        Background="{StaticResource SurfaceDark}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        AutomationProperties.Name="{Binding FileName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                    <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Thumbnail Container with Video Badge -->
                                        <Grid Height="190">
                                            <Border CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource BackgroundDark}">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Video Indicator Badge -->
                                            <Border Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#CC0A0A0A"
                                                    BorderBrush="{StaticResource Gold}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,3"
                                                    Margin="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶ VIDEO" Foreground="{StaticResource GoldLight}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DurationText, StringFormat=' • {0}'}"
                                                               Visibility="{Binding DurationText, Converter={StaticResource EmptyToVisibilityConverter}}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Custom Crop Indicator Badge -->
                                            <Border Visibility="{Binding HasCustomCrop, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#CC252015"
                                                    BorderBrush="{StaticResource Gold}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding CropStatusText}" Foreground="{StaticResource GoldLight}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Filename and Size Details -->
                                        <Grid Margin="0,10,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FileName}"
                                                       AutomationProperties.AutomationId="SelectedFileNameTextBlock"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileSizeText}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Per-image Edit & Layout Action Buttons -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="EDIT CROP"
                                                    AutomationProperties.AutomationId="EditCropButton"
                                                    ToolTip="Adjust framing, zoom, and positioning"
                                                    Click="EditStagedCrop_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallActionButton}"
                                                    Margin="0,0,4,0"/>
                                            <Button Grid.Column="1"
                                                    Content="{Binding LayoutModeText}"
                                                    AutomationProperties.AutomationId="ToggleLayoutButton"
                                                    ToolTip="Toggle between Solo (individual branded image) and Auto/Combine (pair layout)"
                                                    Click="ToggleStagedLayout_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallActionButton}"/>
                                        </Grid>

                                        <!-- Secondary Actions: Reset & Remove -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="RESET"
                                                    AutomationProperties.AutomationId="ResetCropButton"
                                                    ToolTip="Reset crop to default framing"
                                                    Click="ResetStagedCrop_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Visibility="{Binding HasCustomCrop, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}"
                                                    Margin="0,0,6,0"/>
                                            <Button Grid.Column="1"
                                                    Content="REMOVE FROM SELECTION"
                                                    AutomationProperties.AutomationId="RemoveSelectedPhotoButton"
                                                    ToolTip="Remove this item from the selected batch"
                                                    Click="RemoveSelectedPhoto_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallActionButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Results Grid Display -->
            <Grid Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Results Section Header & Quick Action -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceDark}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BRANDED ASSETS (" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Results.Count}" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text=") — Production-ready branded output. Click 'EDIT CROP' on any image to adjust framing without restarting." Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="RESET ALL CROPS"
                                    AutomationProperties.AutomationId="ResetAllResultCropsButton"
                                    ToolTip="Reset crop adjustments for all generated branded images"
                                    Click="ResetAllResultCrops_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource SmallActionButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              AutomationProperties.AutomationId="ResultsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results}"
                                  AutomationProperties.AutomationId="ResultsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="270"
                                        Margin="0,0,16,16"
                                        Background="{StaticResource SurfaceDark}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        AutomationProperties.Name="{Binding FileName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                    <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Image Thumbnail with Video Badge -->
                                        <Grid Height="190">
                                            <Border CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource BackgroundDark}">
                                                <Image Source="{Binding Preview}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Video Indicator Badge -->
                                            <Border Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#CC0A0A0A"
                                                    BorderBrush="{StaticResource Gold}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,3"
                                                    Margin="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶ VIDEO" Foreground="{StaticResource GoldLight}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DurationText, StringFormat=' • {0}'}"
                                                               Visibility="{Binding DurationText, Converter={StaticResource EmptyToVisibilityConverter}}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Custom Crop Indicator Badge -->
                                            <Border Visibility="{Binding HasCustomCrop, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#CC252015"
                                                    BorderBrush="{StaticResource Gold}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="CROPPED" Foreground="{StaticResource GoldLight}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Filename and Details -->
                                        <Grid Margin="0,10,0,10">
                                            <TextBlock Text="{Binding FileName}"
                                                       AutomationProperties.AutomationId="ResultFileNameTextBlock"
                                                       Foreground="{StaticResource GoldLight}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"/>
                                        </Grid>

                                        <!-- Action Buttons: Preview & Save -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="PREVIEW"
                                                    AutomationProperties.AutomationId="PreviewButton"
                                                    ToolTip="Open preview player and inspector"
                                                    Click="Preview_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallActionButton}"
                                                    Margin="0,0,4,0"/>

                                            <Button Grid.Column="1"
                                                    Content="SAVE"
                                                    AutomationProperties.AutomationId="SaveButton"
                                                    ToolTip="Save branded asset"
                                                    Click="Save_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallGoldButton}"/>
                                        </Grid>

                                        <!-- Post-Branding Edit Crop & Reset Buttons -->
                                        <Grid Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="EDIT CROP"
                                                    AutomationProperties.AutomationId="EditResultCropButton"
                                                    ToolTip="Adjust image framing, pan, and zoom without restarting"
                                                    Click="EditResultCrop_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource SmallActionButton}"
                                                    Margin="0,0,4,0"/>

                                            <Button Grid.Column="1"
                                                    Content="RESET"
                                                    AutomationProperties.AutomationId="ResetResultCropButton"
                                                    ToolTip="Reset this image's crop to default framing"
                                                    Click="ResetResultCrop_Click"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Visibility="{Binding HasCustomCrop, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Drop Indicator Overlay for Staged / Results View -->
            <Border IsHitTestVisible="False"
                    Background="#401B160C"
                    BorderBrush="{StaticResource Gold}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Panel.ZIndex="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDragOver}" Value="True"/>
                                    <Condition Binding="{Binding IsEmptyState}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#C5A059" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <Border Background="#2A2013"
                        BorderBrush="{StaticResource GoldLight}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="28,14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="20" Height="20" Fill="{StaticResource GoldLight}" Stretch="Uniform" Margin="0,0,12,0"
                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DROP VIDEOS &amp; PHOTOS TO ADD TO SESSION"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Release files here to stage additional property media"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
