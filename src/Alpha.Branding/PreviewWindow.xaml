<Window x:Class="Alpha.Branding.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Width="900" Height="700" Background="#202124"
        KeyDown="Window_KeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Previous" Click="Previous_Click" Padding="14,6" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding PositionText}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Next" Click="Next_Click" Padding="14,6"/>
        </StackPanel>
        <Image Source="{Binding Current.Preview}" Stretch="Uniform"/>
    </DockPanel>
</Window>
