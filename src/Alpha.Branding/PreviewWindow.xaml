<Window x:Class="Alpha.Branding.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier | Photo Preview"
        Icon="Assets/logo_phoenix.png"
        Width="1080" Height="820"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Image / Video Display -->
            <RowDefinition Height="*"/>
            <!-- Navigation Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Phoenix Mark -->
                <Image Grid.Column="0"
                       Source="Assets/logo_phoenix.png"
                       Height="30" Width="30"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Current Filename & Video Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Current.FileName}"
                               AutomationProperties.AutomationId="PreviewCurrentFileNameTextBlock"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Visibility="{Binding Current.IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#CC0A0A0A"
                            BorderBrush="{StaticResource Gold}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="▶ VIDEO" Foreground="{StaticResource GoldLight}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Position Badge -->
                <Border Grid.Column="2"
                        Background="{StaticResource GoldSubtle}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}"
                               AutomationProperties.AutomationId="PreviewPositionBadgeTextBlock"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- MEDIA VIEWPORT -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,14">
            <Grid>
                <!-- Image Viewer -->
                <Image x:Name="PreviewImageViewer"
                       Source="{Binding Current.Preview}"
                       AutomationProperties.AutomationId="PreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsVideoCurrent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                <!-- Video Player Container -->
                <Grid x:Name="VideoPlayerContainer"
                      Visibility="{Binding IsVideoCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <MediaElement x:Name="VideoPlayer"
                                  Grid.Row="0"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded"/>

                    <!-- Video Controls Bar -->
                    <Border Grid.Row="1"
                            Background="#E60D0E10"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Play/Pause Button -->
                            <Button x:Name="PlayPauseButton"
                                    Grid.Column="0"
                                    Content="▶ PLAY"
                                    AutomationProperties.AutomationId="VideoPlayPauseButton"
                                    Click="PlayPause_Click"
                                    Style="{StaticResource SmallGoldButton}"
                                    Margin="0,0,14,0"/>

                            <!-- Timeline / Seek Slider -->
                            <Slider x:Name="TimelineSlider"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="VideoTimelineSlider"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                    PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                    ValueChanged="TimelineSlider_ValueChanged"/>

                            <!-- Time Display -->
                            <TextBlock x:Name="TimeTextBlock"
                                       Grid.Column="2"
                                       AutomationProperties.AutomationId="VideoTimeTextBlock"
                                       Text="0:00 / 0:00"
                                       Foreground="{StaticResource GoldLight}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <!-- Mute Toggle -->
                            <Button x:Name="MuteButton"
                                    Grid.Column="3"
                                    Content="🔊"
                                    AutomationProperties.AutomationId="VideoMuteButton"
                                    Click="Mute_Click"
                                    Style="{StaticResource SmallActionButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- NAVIGATION FOOTER -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceDark}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ALPHA PREMIER REALTY" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <!-- Centered Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀  PREVIOUS"
                            AutomationProperties.AutomationId="PreviewPreviousButton"
                            ToolTip="View previous asset (Left Arrow)"
                            IsEnabled="{Binding HasMultiplePhotos}"
                            Click="Previous_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,9"
                            Margin="0,0,12,0"/>

                    <Button Content="NEXT  ▶"
                            AutomationProperties.AutomationId="PreviewNextButton"
                            ToolTip="View next asset (Right Arrow)"
                            IsEnabled="{Binding HasMultiplePhotos}"
                            Click="Next_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="22,9"/>
                </StackPanel>

                <!-- Keyboard Hint -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="← / → to navigate • Space to Play/Pause • Esc to close"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
