<Window x:Class="Alpha.Branding.CropEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier | Crop &amp; Alignment Editor"
        Icon="Assets/logo_phoenix.png"
        Width="1020" Height="780"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GlassBackdrop}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto"/>
            <!-- Interactive viewport -->
            <RowDefinition Height="*"/>
            <!-- Tool strip -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource GlassPanel}"
                    CornerRadius="12"
                    Width="40" Height="40"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <Image Source="Assets/logo_phoenix.png"
                       Height="28" Width="28"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Crop &amp; alignment"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock x:Name="ItemTitleTextBlock"
                           AutomationProperties.AutomationId="CropEditorItemTitleTextBlock"
                           Text="{Binding ItemTitle}"
                           ToolTip="{Binding ActiveFilePath}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Pair slot switcher + canvas size -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border x:Name="SlotSelectorContainer"
                        Style="{StaticResource SegmentTrack}"
                        Visibility="{Binding HasMultipleSlots, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftSlotRadio"
                                     AutomationProperties.AutomationId="LeftSlotRadio"
                                     Content="Left photo"
                                     ToolTip="{Binding LeftFileName}"
                                     IsChecked="{Binding IsLeftSlotSelected, Mode=TwoWay}"
                                     Checked="SlotRadio_Changed"
                                     Style="{StaticResource SmallActionToggleButton}"
                                     MinWidth="96"
                                     Margin="0,0,2,0"/>
                        <RadioButton x:Name="RightSlotRadio"
                                     AutomationProperties.AutomationId="RightSlotRadio"
                                     Content="Right photo"
                                     ToolTip="{Binding RightFileName}"
                                     IsChecked="{Binding IsRightSlotSelected, Mode=TwoWay}"
                                     Checked="SlotRadio_Changed"
                                     Style="{StaticResource SmallActionToggleButton}"
                                     MinWidth="96"
                                     Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Pill}" Padding="14,6">
                    <TextBlock x:Name="CanvasDimensionsTextBlock"
                               Text="{Binding TargetDimensionsText}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- INTERACTIVE CROP VIEWPORT: glass panel around a dark well so the photo stays true -->
        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Style="{StaticResource Well}" CornerRadius="10" ClipToBounds="True">
                <Grid x:Name="ViewportHost"
                      ClipToBounds="True"
                      Background="#0C0D10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <!-- Focusable wrapper: arrow keys move the photo for keyboard users -->
                    <UserControl x:Name="ViewportFocus"
                                 AutomationProperties.AutomationId="CropViewport"
                                 AutomationProperties.Name="Photo position"
                                 AutomationProperties.HelpText="Arrow keys move the photo. Hold Shift for larger steps."
                                 Focusable="True"
                                 FocusVisualStyle="{x:Null}"
                                 KeyDown="Viewport_KeyDown">
                        <!-- Outer Frame Viewbox keeping exact aspect ratio -->
                        <Viewbox x:Name="AspectViewbox" Stretch="Uniform">
                            <Grid x:Name="TargetCanvas"
                                  Width="{Binding TargetWidth}"
                                  Height="{Binding TargetHeight}"
                                  Background="#121212"
                                  ClipToBounds="True"
                                  Cursor="SizeAll"
                                  MouseDown="Canvas_MouseDown"
                                  MouseMove="Canvas_MouseMove"
                                  MouseUp="Canvas_MouseUp"
                                  MouseLeave="Canvas_MouseUp"
                                  MouseWheel="Canvas_MouseWheel">

                                <!-- Photo Image with Pan and Zoom RenderTransform -->
                                <Image x:Name="PhotoImage"
                                       AutomationProperties.AutomationId="CropEditorPhotoImage"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                                <Canvas x:Name="RedactOverlay" IsHitTestVisible="False"/>
                                <TextBlock AutomationProperties.AutomationId="RedactOverlay"
                                           AutomationProperties.Name="Pen marks overlay"
                                           Text="Pen marks overlay"
                                           Foreground="Transparent"
                                           IsHitTestVisible="False"
                                           Focusable="False"/>

                                <!-- Rule of thirds alignment grid guidelines (subtle); stretched to the frame so
                                     the thirds stay correct for the half-width pair slots too -->
                                <Viewbox Stretch="Fill" IsHitTestVisible="False">
                                    <Canvas x:Name="GridGuidelines" Width="1200" Height="1000" Opacity="0.25">
                                        <Line X1="400" Y1="0" X2="400" Y2="1000" Stroke="{StaticResource GoldLight}" StrokeDashArray="4 4" StrokeThickness="1"/>
                                        <Line X1="800" Y1="0" X2="800" Y2="1000" Stroke="{StaticResource GoldLight}" StrokeDashArray="4 4" StrokeThickness="1"/>
                                        <Line X1="0" Y1="333" X2="1200" Y2="333" Stroke="{StaticResource GoldLight}" StrokeDashArray="4 4" StrokeThickness="1"/>
                                        <Line X1="0" Y1="667" X2="1200" Y2="667" Stroke="{StaticResource GoldLight}" StrokeDashArray="4 4" StrokeThickness="1"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- Live Branding Overlay Layer -->
                                <Image x:Name="OverlayImage"
                                       AutomationProperties.AutomationId="CropEditorOverlayImage"
                                       Stretch="Fill"
                                       IsHitTestVisible="False"
                                       Opacity="0.95"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Viewbox>
                    </UserControl>
                </Grid>
            </Border>
        </Border>

        <!-- TOOL STRIP: three groups that wrap as whole units on narrow windows -->
        <Border Grid.Row="2"
                Style="{StaticResource GlassPanel}"
                Padding="14,8"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">

                <!-- Canvas mode + pen options -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                    <Border Style="{StaticResource SegmentTrack}" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PanModeToggle"
                                         GroupName="CanvasMode"
                                         AutomationProperties.AutomationId="PanModeToggle"
                                         AutomationProperties.Name="Pan mode"
                                         Content="Pan"
                                         ToolTip="Drag to move the photo within the frame"
                                         Style="{StaticResource SmallActionToggleButton}"
                                         MinWidth="60"
                                         Margin="0,0,2,0"/>
                            <RadioButton x:Name="RedactModeToggle"
                                         GroupName="CanvasMode"
                                         AutomationProperties.AutomationId="RedactModeToggle"
                                         AutomationProperties.Name="Pen mode"
                                         Content="Pen"
                                         ToolTip="Draw pen marks over the photo to hide details"
                                         Style="{StaticResource SmallActionToggleButton}"
                                         MinWidth="60"
                                         Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Size"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Slider x:Name="BrushSizeSlider"
                            AutomationProperties.AutomationId="BrushSizeSlider"
                            AutomationProperties.Name="Pen size"
                            Minimum="2" Maximum="60" Value="12"
                            Width="100"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            ToolTip="Pen size"
                            Margin="0,0,10,0"/>

                    <Button x:Name="UndoRedactButton"
                            AutomationProperties.AutomationId="UndoRedactButton"
                            AutomationProperties.Name="Undo last pen mark"
                            Content="Undo"
                            ToolTip="Undo the last pen mark (Ctrl+Z)"
                            Style="{StaticResource SmallActionButton}"
                            MinWidth="56"
                            Margin="0,0,6,0"/>

                    <Button x:Name="ClearRedactButton"
                            AutomationProperties.AutomationId="ClearRedactButton"
                            AutomationProperties.Name="Clear pen marks"
                            Content="Clear marks"
                            ToolTip="Erase all pen marks on this photo (Undo or Ctrl+Z restores them)"
                            Style="{StaticResource DestructiveActionButton}"
                            MinWidth="56"/>
                </StackPanel>

                <!-- Zoom -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,24,4">
                    <TextBlock Text="Zoom"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Button x:Name="ZoomOutButton"
                            AutomationProperties.AutomationId="ZoomOutButton"
                            AutomationProperties.Name="Zoom out"
                            Content="−"
                            ToolTip="Zoom out (−10%) to show more of the photo"
                            Click="ZoomOut_Click"
                            Style="{StaticResource SmallActionButton}"
                            Width="32" Height="32"
                            FontSize="14"
                            Padding="0"
                            Margin="0,0,8,0"/>

                    <Slider x:Name="ZoomSlider"
                            AutomationProperties.AutomationId="ZoomSlider"
                            AutomationProperties.Name="Zoom level"
                            Minimum="0.2"
                            Maximum="4.0"
                            SmallChange="0.05"
                            LargeChange="0.2"
                            Value="{Binding ActiveCrop.Zoom, Mode=TwoWay}"
                            ValueChanged="ZoomSlider_ValueChanged"
                            Width="160"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>

                    <Button x:Name="ZoomInButton"
                            AutomationProperties.AutomationId="ZoomInButton"
                            AutomationProperties.Name="Zoom in"
                            Content="+"
                            ToolTip="Zoom in (+10%)"
                            Click="ZoomIn_Click"
                            Style="{StaticResource SmallActionButton}"
                            Width="32" Height="32"
                            FontSize="14"
                            Padding="0"
                            Margin="0,0,10,0"/>

                    <Border Style="{StaticResource Chip}" Padding="8,4">
                        <TextBlock x:Name="ZoomValueTextBlock"
                                   AutomationProperties.AutomationId="ZoomValueTextBlock"
                                   Typography.NumeralAlignment="Tabular"
                                   Text="{Binding ActiveCrop.ZoomPercentageText}"
                                   Style="{StaticResource ChipText}"
                                   FontSize="11"
                                   Width="42"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Framing presets & orientation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <Button x:Name="FitToFrameButton"
                            AutomationProperties.AutomationId="FitToFrameButton"
                            Content="Fit"
                            ToolTip="Show the whole photo without cropping"
                            Click="FitToFrame_Click"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,6,0"/>

                    <Button x:Name="FillFrameButton"
                            AutomationProperties.AutomationId="FillFrameButton"
                            Content="Fill"
                            ToolTip="Fill the entire frame (centered crop)"
                            Click="FillFrame_Click"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,6,0"/>

                    <Button x:Name="RotateButton"
                            AutomationProperties.AutomationId="RotateButton"
                            AutomationProperties.Name="Rotate 90° clockwise"
                            Content="↻ Rotate 90°"
                            ToolTip="Rotate the photo 90° clockwise"
                            Click="Rotate_Click"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,6,0"/>

                    <Button x:Name="ResetCropButton"
                            AutomationProperties.AutomationId="ResetCropButton"
                            Content="Reset"
                            ToolTip="Reset pan, zoom and rotation (pen marks are kept)"
                            Click="ResetCrop_Click"
                            Style="{StaticResource SmallActionButton}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- FOOTER: offset readout and hint on the left, Cancel / Save on the right -->
        <Grid Grid.Row="3" Margin="6,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="Offset "
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="PanCoordinatesTextBlock"
                               AutomationProperties.AutomationId="PanCoordinatesTextBlock"
                               Typography.NumeralAlignment="Tabular"
                               Text="{Binding PanCoordinatesText}"
                               Foreground="{StaticResource GoldLight}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock AutomationProperties.AutomationId="CropEditorHintTextBlock"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Drag or use arrow keys to move the photo • Scroll to zoom • Enter to save • Esc to cancel"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RedactModeToggle}" Value="True">
                                    <Setter Property="Text" Value="Drag to draw • Ctrl+Z undoes the last mark • Esc returns to Pan"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="CancelCropButton"
                        Content="Cancel"
                        ToolTip="Discard changes and close (Esc; in Pen mode press Esc twice)"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0"/>

                <Button x:Name="SaveChangesButton"
                        AutomationProperties.AutomationId="SaveCropButton"
                        Content="Save changes"
                        ToolTip="Save crop and pen changes and close (Enter)"
                        Click="SaveChanges_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
