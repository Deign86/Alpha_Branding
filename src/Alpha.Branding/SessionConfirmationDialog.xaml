<Window x:Class="Alpha.Branding.SessionConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start a new branding session?"
        Icon="Assets/logo_phoenix.png"
        Width="640"
        MinWidth="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Poppins, sans-serif">

    <Border Background="{StaticResource SurfaceDark}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16"
            Padding="22">
        <StackPanel>
            <!-- Header with Phoenix Mark and Title -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="Assets/logo_phoenix.png"
                       Height="38"
                       Width="38"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Start a new branding session?"
                               AutomationProperties.AutomationId="ConfirmationTitleTextBlock"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="17"
                               FontWeight="Bold"/>
                    <TextBlock Text="Alpha Premier Realty • Session Protection"
                               Foreground="{StaticResource Gold}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Warning Notice Card -->
            <Border Background="{StaticResource SurfaceElevated}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                <TextBlock x:Name="MessageTextBlock"
                           Text="You have unsaved edits in the current session. Applying branding to the newly selected photos will replace the current photos and discard those unsaved edits."
                           AutomationProperties.AutomationId="ConfirmationMessageTextBlock"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        AutomationProperties.AutomationId="ConfirmationCancelButton"
                        ToolTip="Keep the current session and cancel starting a new session"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"/>

                <Button Content="DISCARD EDITS &amp; CONTINUE"
                        AutomationProperties.AutomationId="ConfirmationDiscardButton"
                        ToolTip="Discard unsaved edits and begin branding the newly selected photos"
                        Click="Discard_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"/>

                <Button Content="SAVE &amp; CONTINUE"
                        AutomationProperties.AutomationId="ConfirmationSaveButton"
                        ToolTip="Export current session first, then begin branding newly selected photos"
                        Click="Save_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
