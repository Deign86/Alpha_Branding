<Window x:Class="Alpha.Branding.Bootstrapper.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha Premier Realty Branding Studio — Uninstall"
        Width="540" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Charcoal}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/logo.png" Height="40" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Alpha Premier Realty" Foreground="{StaticResource Gold}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Branding Studio — Uninstaller" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <!-- Ready View -->
            <StackPanel x:Name="ReadyPanel" Visibility="Visible" VerticalAlignment="Center">
                <TextBlock Text="Uninstall Confirmation" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Are you sure you want to completely remove Alpha Premier Realty Branding Studio and all of its components from your computer?"
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" LineHeight="20"/>
            </StackPanel>

            <!-- Uninstalling View -->
            <StackPanel x:Name="UninstallingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Uninstalling..." FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ProgressBar x:Name="UninstallProgressBar" Value="0" Maximum="100" Height="14" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtStatus" Text="Removing application components..." Foreground="{StaticResource Gold}" FontSize="13"/>
            </StackPanel>

            <!-- Finished View -->
            <StackPanel x:Name="FinishedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Uninstallation Complete" Foreground="{StaticResource Gold}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Alpha Premier Realty Branding Studio was successfully removed from your computer."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" LineHeight="20"/>
            </StackPanel>

            <!-- Error View -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Uninstallation Failed" Foreground="#EF4444" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="#2B1A1A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtErrorMessage" TextWrapping="Wrap" Foreground="#FCA5A5" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Width="90"/>
                <Button x:Name="BtnUninstall" Style="{StaticResource PrimaryButton}" Content="Uninstall" Click="BtnUninstall_Click" DockPanel.Dock="Right" Width="100"/>
                <Button x:Name="BtnClose" Style="{StaticResource PrimaryButton}" Content="Close" Click="BtnClose_Click" DockPanel.Dock="Right" Width="90" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
